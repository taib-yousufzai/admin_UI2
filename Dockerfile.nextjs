# syntax=docker/dockerfile:1
FROM node:20-alpine AS deps
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Install dependencies
COPY package.json package-lock.json* ./
RUN npm install

FROM node:20-alpine AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Provide build-time arguments / environment variables needed by Next.js compilation
ARG NEXT_PUBLIC_SUPABASE_URL="https://cpcvklekwwawgtgbyrmp.supabase.co"
ARG NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_H1dUWo3T6tJgKD4DzJ_5sw_WhOiOkdr"
ARG NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_H1dUWo3T6tJgKD4DzJ_5sw_WhOiOkdr"
ARG NEXT_PUBLIC_KITE_API_KEY="5xdqm1c9hs945oo0"
ARG NEXT_PUBLIC_TICKER_URL="https://marginapexx-production.up.railway.app"
ARG NEXT_PUBLIC_TICKER_WS_URL="wss://marginapexx-production.up.railway.app"
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAETvCsxhjzBrbJ6P"
ARG SUPABASE_SERVICE_ROLE_KEY="placeholder-service-role-key"

ENV NEXT_PUBLIC_SUPABASE_URL=$NEXT_PUBLIC_SUPABASE_URL
ENV NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_SUPABASE_ANON_KEY=$NEXT_PUBLIC_SUPABASE_ANON_KEY
ENV NEXT_PUBLIC_KITE_API_KEY=$NEXT_PUBLIC_KITE_API_KEY
ENV NEXT_PUBLIC_TICKER_URL=$NEXT_PUBLIC_TICKER_URL
ENV NEXT_PUBLIC_TICKER_WS_URL=$NEXT_PUBLIC_TICKER_WS_URL
ENV NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY
ENV SUPABASE_SERVICE_ROLE_KEY=$SUPABASE_SERVICE_ROLE_KEY

RUN mkdir -p /app/public
RUN npm run build

# Production image — only runtime artifacts
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=8008
ENV HOSTNAME="0.0.0.0"

RUN apk add --no-cache libc6-compat

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 8008

CMD ["node", "server.js"]
